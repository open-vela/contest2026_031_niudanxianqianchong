config SMART_HOME_CAMERA_PREVIEW
    bool "Enable local SC2336 device preview"
    depends on ARCH_BOARD_ESP32P4_FUNCTION_EV_BOARD
    depends on ESP32P4_FUNCTION_EV_BOARD_CAMERA_SC2336_VIDEO
    default n
    help
      Enable the Smart Home-owned /dev/video0 consumer. The camera service
      captures the SC2336 RGB565 stream in a worker and publishes a copied
      512x300 preview to the LVGL device popup at a maximum of 15 FPS.
      It is intentionally independent of cAGENT and network services.

config SMART_HOME_CAMERA_PPA
    bool "Scale camera previews with ESP32-P4 PPA"
    depends on SMART_HOME_CAMERA_PREVIEW && ESP32P4_PPA
    default n
    help
      Scale RGB565 frames from 1024x600 to 512x300 using PPA on CPU0.
      Keep capture buffers until DMA completes; use CPU scaling if PPA
      initialization or a job fails after safe buffer ownership recovery.
      Print hardware/CPU frame counts and scaling times for board checks.

config SMART_HOME_CAMERA_TOOL
    bool "Agent camera tool (power + snapshot)"
    depends on SMART_HOME_CAMERA_PREVIEW
    default n
    help
      Register a local agent tool `camera` with status/on/off/shot
      actions.  `shot` captures the latest 512x300 preview, computes
      brightness and frame-to-frame motion, and stores two rolling
      files under /data/smart_home/snapshots (about 600 KB total).
      Runs only through the camera service; it never opens /dev/video0.
      Needs about 600 KB of free space on /data for the two slots.

config SMART_HOME_MILOCO_BRIDGE
    bool "Enable Xiaomi Miloco gateway bridge"
    depends on SMART_HOME_DEMO_UI_LVGL
    default n
    help
      Bridge remote Mi Home devices through a Xiaomi Miloco backend that
      runs on a home server. Devices are polled over plain LAN HTTP
      (default port 1810) and displayed as remote cards on the device
      panel; power control is issued via the /miot REST API from a
      dedicated worker thread. Gateway host/port/token are stored in
      secrets.json and configured from the settings page.

config SMART_HOME_ONBOARDING
    bool "First-run configuration guide"
    depends on SMART_HOME_DEMO_UI_LVGL
    default y
    help
      Show a setup overlay on the home screen while the Wi-Fi link, the
      Miloco gateway or the model service is still unconfigured. The
      overlay lists the three items side by side, jumps to the matching
      settings page, and can always be dismissed with "later".

      It covers the home screen but does not block it: the home page is
      fully built first, so dismissing the overlay immediately shows the
      demo content. The dismissal is memory-only for this boot, because
      writing LittleFS from the LVGL thread hard-freezes the system.

      Say N to build without the overlay, for example for a demo image
      that must boot straight into the product screens.

config SMART_HOME_MILOCO_VOLATILE_CONFIG
    bool "Miloco gateway config is memory-only (skip secrets.json write)"
    depends on SMART_HOME_MILOCO_BRIDGE
    default n
    help
      Workaround while a smart_home-runtime flash write hard-freezes the
      system (MSPI arbitration during LittleFS erase).  The gateway
      configuration is applied to the worker directly and lost on reboot;
      the bind page reads the running config from the service instead of
      secrets.json.  Re-enable persistence once the flash-write freeze is
      root-caused.

config SMART_HOME_DEMO_STATIC_LVGL_HOME
    bool "P4X static LVGL home screen"
    depends on ARCH_BOARD_ESP32P4_FUNCTION_EV_BOARD
    default n
    help
      Build only the local, static Smart Home home screen for the
      ESP32-P4X-Function-EV-Board. This P2 bring-up profile uses /dev/fb0
      and LVGL but intentionally does not initialize cAGENT, networking,
      model credentials, MCP, Node gateway, mobile App bridge, or touch
      input. It keeps the first visual integration test isolated from all
      cloud and peripheral dependencies.

config SMART_HOME_DEMO_LVGL_FB_PATH
    string "LVGL framebuffer device path"
    default "/dev/lcd0" if LV_USE_NUTTX_LCD
    default "/dev/fb0"
    help
      Framebuffer or LCD device opened by the LVGL NuttX port. The P4X
      framebuffer profile uses /dev/fb0; existing LCD-based targets retain
      /dev/lcd0 when LV_USE_NUTTX_LCD is enabled.

config SMART_HOME_DEMO_UI_LVGL_ICONS
    string "LVGL UI icons directory"
    default "/data/res/icons"
    help
      Filesystem path where PNG icons are installed. The 25 icon files
      from res/icons/ should be copied to this directory via ROMFS mount
      or data partition pre-population.

endif

config SMART_HOME_WIFI_SSID
    string "Default WiFi SSID"
    default "123"
    depends on SMART_HOME_DEMO
    help
        Compile-time default WiFi SSID. Used when /data/wapi.conf does not
        exist or cannot be parsed. Users can override at runtime by writing
        a JSON config to /data/wapi.conf (see docs/esp32s3-box.md).

config SMART_HOME_WIFI_PASSWORD
    string "Default WiFi password"
    default "88888888"
    depends on SMART_HOME_DEMO
    help
        Compile-time default WPA2 password. Used when /data/wapi.conf does
        not exist or cannot be parsed.

config SMART_HOME_WIFI_RETRY_COUNT
    int "WiFi connection retry count"
    default 3
    range 1 10
    depends on SMART_HOME_DEMO
    help
        Number of times to retry WiFi connection before giving up.

endif

diff --git a/nuttx/src/platform/os.c b/nuttx/src/platform/os.c
index 99470d7e7c0..f4e78f3728c 100644
--- a/nuttx/src/platform/os.c
+++ b/nuttx/src/platform/os.c
@@ -1111,7 +1111,11 @@ void nuttx_enter_critical(void)
 
   flags = up_irq_save();
 
+#ifdef CONFIG_IDF_TARGET_ARCH_RISCV
+  __asm__ __volatile__("csrr %0, mhartid" : "=r"(cpu));
+#else
   cpu = this_cpu();
+#endif
 
   if (g_int_flags_count[cpu] == 0)
     {
@@ -1125,7 +1129,14 @@ void nuttx_enter_critical(void)
 
 #if OS_SPINLOCK == 1
 #  ifdef CONFIG_SPINLOCK
-  rspin_lock(lock);
+  /* Spinlocks depend on per-CPU state that does not exist before the
+   * scheduler starts; interrupts are already disabled at this point.
+   */
+
+  if (OSINIT_OS_READY())
+    {
+      rspin_lock(lock);
+    }
 #  endif
 #endif
 
@@ -1150,13 +1161,22 @@ void nuttx_exit_critical(FAR rspinlock_t *lock)
 void nuttx_exit_critical(void)
 #endif
 {
-  int cpu = this_cpu();
+  int cpu;
+
+#ifdef CONFIG_IDF_TARGET_ARCH_RISCV
+  __asm__ __volatile__("csrr %0, mhartid" : "=r"(cpu));
+#else
+  cpu = this_cpu();
+#endif
 
   g_int_flags_count[cpu]--;
 
 #if OS_SPINLOCK == 1
 #  ifdef CONFIG_SPINLOCK
-  rspin_unlock(lock);
+  if (OSINIT_OS_READY())
+    {
+      rspin_unlock(lock);
+    }
 #  endif
 #endif
 

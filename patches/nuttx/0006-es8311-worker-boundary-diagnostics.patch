Subject: [PATCH 6/6] audio: trace ES8311 worker startup and queue wait

The start boundary trace proves that AUDIOIOC_START returns after the ES8311
worker is created, but the console stalls before the first application buffer
is submitted. Trace the worker's first process pass and message-queue wait to
distinguish normal blocking from a failed receive loop.

The receive error log is rate-limited to the first consecutive failure so a
high-priority worker cannot flood the console during diagnosis. Apply after
0005-es8311-start-boundary-diagnostics.patch.

Use contextual hunks so the wait log precedes the blocking receive and
the error counter precedes continue when replayed on the pinned baseline.

--- a/drivers/audio/es8311.c
+++ b/drivers/audio/es8311.c
@@ -2054,9 +2054,13 @@
   struct audio_msg_s msg;
   FAR struct ap_buffer_s *apb;
   int msglen;
+  int ret;
   unsigned int prio;
+  unsigned int mq_errors = 0;
+  bool first_iteration = true;

   audinfo("ES8311 worker thread starting\n");
+  syslog(LOG_INFO, "INFO: ES8311 worker: entered\n");

 #ifndef CONFIG_AUDIO_EXCLUDE_STOP
   priv->terminating = false;
@@ -2085,10 +2089,29 @@
         {
           /* Check if we can process more audio buffers */

-          es8311_processbegin(priv);
+          if (first_iteration)
+            {
+              syslog(LOG_INFO,
+                     "INFO: ES8311 worker: process begin inflight=%d\n",
+                     priv->inflight);
+            }
+
+          ret = es8311_processbegin(priv);
+          if (first_iteration)
+            {
+              syslog(LOG_INFO,
+                     "INFO: ES8311 worker: process end ret=%d inflight=%d\n",
+                     ret, priv->inflight);
+            }
         }

       /* Wait for messages from our message queue */
+
+      if (first_iteration)
+        {
+          syslog(LOG_INFO, "INFO: ES8311 worker: mq wait\n");
+          first_iteration = false;
+        }

       msglen = file_mq_receive(&priv->mq, (FAR char *)&msg,
                                sizeof(msg), &prio);
@@ -2097,8 +2120,20 @@

       if (msglen < sizeof(struct audio_msg_s))
         {
+          if (mq_errors == 0)
+            {
+              syslog(LOG_ERR,
+                     "ERROR: ES8311 worker: mq receive failed len=%d\n",
+                     msglen);
+            }
+
+          mq_errors++;
           auderr("Message too small: %d\n", msglen);
           continue;
         }
+
+      mq_errors = 0;
+      syslog(LOG_INFO, "INFO: ES8311 worker: mq received len=%d id=%d\n",
+             msglen, msg.msg_id);

       /* Process the message */

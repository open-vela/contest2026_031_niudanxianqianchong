Subject: [PATCH 5/5] audio: trace ES8311 start and initial enqueue

The first smoke-test trace reaches the ES8311 start register sequence but
the serial device disconnects before it can distinguish the final I2C write,
worker startup, and first DMA buffer submission. Add completion and boundary
logs at those transitions.

These are temporary bring-up diagnostics. Apply after
0004-es8311-audio-smoke-diagnostics.patch.

--- a/drivers/audio/es8311.c
+++ b/drivers/audio/es8311.c
@@ -1470,6 +1470,8 @@
   uint8_t adc_iface;

   audinfo("ES8311 Start\n");
+  syslog(LOG_INFO, "INFO: ES8311 start: begin mode=%d\n",
+         priv->audio_mode);

   if (priv->audio_mode == ES_MODULE_LINE)
     {
@@ -1504,6 +1506,8 @@
   /* Set internal reference signal (ADCL + DACR) */

   ret |= es8311_writereg(priv, ES8311_GPIO_REG44, 0x50);
+  syslog(LOG_INFO, "INFO: ES8311 start: control registers complete ret=%d\n",
+         ret);

   if (ret < 0)
     {
@@ -1525,6 +1529,7 @@
   attr.mq_curmsgs = 0;
   attr.mq_flags   = 0;

+  syslog(LOG_INFO, "INFO: ES8311 start: worker mq create begin\n");
   ret = file_mq_open(&priv->mq, priv->mqname,
                      O_RDWR | O_CREAT, 0644, &attr);
   if (ret < 0)
@@ -1537,6 +1542,7 @@

   /* Join any old worker thread we had created to prevent a memory leak */

+  syslog(LOG_INFO, "INFO: ES8311 start: worker mq create OK\n");
   if (priv->threadid != 0)
     {
       audinfo("Joining old thread\n");
@@ -1551,6 +1557,7 @@
   pthread_attr_setstacksize(&tattr, CONFIG_ES8311_WORKER_STACKSIZE);

   audinfo("Starting worker thread\n");
+  syslog(LOG_INFO, "INFO: ES8311 start: worker create begin\n");
   ret = pthread_create(&priv->threadid, &tattr, es8311_workerthread,
                        (pthread_addr_t)priv);
   if (ret != OK)
@@ -1561,6 +1568,7 @@
     {
       pthread_setname_np(priv->threadid, "es8311");
       audinfo("Created worker thread\n");
+      syslog(LOG_INFO, "INFO: ES8311 start: worker create OK\n");
     }

   return ret;

Subject: [PATCH 4/4] audio: add ES8311 smoke-test diagnostics

Add visible preparation-stage logs to the Smart Home audio smoke command and
codec/I2S/I2C boundary logs to the ES8311 lower-half. This makes a blocked
configuration distinguishable from a DMA completion failure and identifies
the final I2C register operation entered before a bus transfer stalls.

These are temporary bring-up diagnostics. Apply after
0003-es8311-propagate-configure-errors.patch.

--- a/drivers/audio/es8311.c
+++ b/drivers/audio/es8311.c
@@ -41,6 +41,7 @@
 #include <stdint.h>
 #include <stdio.h>
 #include <string.h>
+#include <syslog.h>

 #include <nuttx/audio/audio.h>
 #include <nuttx/audio/es8311.h>
@@ -255,6 +256,8 @@
        * completed.
        */

+      syslog(LOG_INFO, "INFO: ES8311 I2C read begin: reg=0x%02x try=%d\n",
+             (unsigned int)regaddr, retries + 1);
       ret = I2C_TRANSFER(priv->i2c, msg, 2);
       if (ret < 0)
         {
@@ -336,6 +339,9 @@
        * completed.
        */

+      syslog(LOG_INFO,
+             "INFO: ES8311 I2C write begin: reg=0x%02x val=0x%02x try=%d\n",
+             (unsigned int)regaddr, (unsigned int)regval, retries + 1);
       ret = i2c_write(priv->i2c, &config, data, 2);
       if (ret < 0)
         {
@@ -360,6 +366,9 @@
            * return.
            */

+          syslog(LOG_INFO,
+                 "INFO: ES8311 I2C write done: reg=0x%02x ret=%d\n",
+                 (unsigned int)regaddr, ret);
           audinfo("Write: %02x <- %02x\n", regaddr, regval);
           return OK;
         }
@@ -598,6 +607,9 @@

   DEBUGASSERT(priv && priv->lower);

+  syslog(LOG_INFO, "INFO: ES8311 width: begin bps=%d mode=%d\n",
+         priv->bpsamp, priv->audio_mode);
+
   switch (priv->bpsamp)
     {
       case 16:
@@ -624,6 +636,7 @@
       return ret;
     }

+  syslog(LOG_INFO, "INFO: ES8311 width: I2S RX configured\n");
   ret = I2S_TXDATAWIDTH(priv->i2s, priv->bpsamp);
   if (ret < 0)
     {
@@ -631,6 +644,7 @@
       return ret;
     }

+  syslog(LOG_INFO, "INFO: ES8311 width: I2S TX configured\n");
   ret = 0;
   if (priv->audio_mode == ES_MODULE_ADC ||
       priv->audio_mode == ES_MODULE_ADC_DAC)
@@ -685,6 +699,10 @@

   priv->mclk = I2S_GETMCLKFREQUENCY(priv->i2s);
   coeff_index = es8311_getcoeff(priv, priv->samprate);
+  syslog(LOG_INFO,
+         "INFO: ES8311 samplerate: begin rate=%" PRIu32
+         " mclk=%" PRIu32 " coeff=%d\n",
+         priv->samprate, priv->mclk, coeff_index);

   if (coeff_index < 0)
     {
@@ -699,6 +717,7 @@
       return ret;
     }

+  syslog(LOG_INFO, "INFO: ES8311 samplerate: I2S RX configured\n");
   ret = I2S_TXSAMPLERATE(priv->i2s, priv->samprate);
   if (ret < 0)
     {
@@ -706,6 +725,8 @@
       return ret;
     }

+  syslog(LOG_INFO, "INFO: ES8311 samplerate: I2S TX configured\n");
+  syslog(LOG_INFO, "INFO: ES8311 samplerate: codec clocks begin\n");
   ret = 0;
   regconfig = es8311_readreg(priv, ES8311_CLK_MANAGER_REG02) & 0x07;
   regconfig |= (es8311_coeff_div[coeff_index].pre_div - 1) << 5;
@@ -771,6 +792,8 @@

   ret |= es8311_writereg(priv, ES8311_CLK_MANAGER_REG06, regconfig);

+  syslog(LOG_INFO, "INFO: ES8311 samplerate: codec clocks complete\n");
+
   if (ret < 0)
     {
       auderr("Failed to set sample rate.\n");
@@ -1036,14 +1059,22 @@
             break;
           }

+        syslog(LOG_INFO,
+               "INFO: ES8311 configure output: mode/reset begin"
+               " rate=%" PRIu32 " bps=%u\n",
+               caps->ac_controls.hw[0],
+               (unsigned int)caps->ac_controls.b[2]);
         es8311_audio_output(priv);
         es8311_reset(priv);
+        syslog(LOG_INFO, "INFO: ES8311 configure output: mode/reset done\n");

         /* Save the current stream configuration */

         priv->samprate  = caps->ac_controls.hw[0];
         priv->bpsamp    = caps->ac_controls.b[2];

+        syslog(LOG_INFO,
+               "INFO: ES8311 configure output: samplerate begin\n");
         ret = es8311_setsamplerate(priv);
         if (ret == -ENOTTY)
           {
@@ -1055,10 +1086,14 @@
             break;
           }

+        syslog(LOG_INFO, "INFO: ES8311 configure output: width begin\n");
         ret = es8311_setbitspersample(priv);
         if (ret == -ENOTTY)
           {
             ret = OK;
           }
+
+        syslog(LOG_INFO, "INFO: ES8311 configure output: complete ret=%d\n",
+               ret);
       }
       break;

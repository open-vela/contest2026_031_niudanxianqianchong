############################################################################
# packages/cAGENT/Make.defs
#
# cAGENT (vendored cAgentV2) NuttX package registration.
############################################################################

ifneq ($(CONFIG_CAGENT),)
CONFIGURED_APPS += $(APPDIR)/packages/cAGENT
CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/packages/cAGENT/include
CFLAGS += -DAGENT_BUILD_CONFIG_HEADER=\"nuttx/config.h\"
CXXFLAGS += -DAGENT_BUILD_CONFIG_HEADER=\"nuttx/config.h\"
endif

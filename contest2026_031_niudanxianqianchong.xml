<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_031_niudanxianqianchong" name="contest2026_031_niudanxianqianchong">
    <linkfile src="app/hello_app" dest="packages/demos/contest2026_031_hello_app"/>
    <linkfile src="app/dsi_probe" dest="packages/demos/contest2026_031_dsi_probe"/>
    <linkfile src="app/csi_probe" dest="packages/demos/contest2026_031_csi_probe"/>
    <linkfile src="quickapp/hello_quickapp" dest="packages/apps/contest2026_031_hello_quickapp"/>
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_031_board"/>

    <!-- ESP32-P4 chip and board -->
    <linkfile src="chips/esp32p4" dest="vendor/espressif/chips/esp32p4"/>
    <linkfile src="board/esp32p4/common" dest="vendor/espressif/boards/esp32p4/common"/>
    <linkfile src="board/esp32p4/esp32p4-function-ev-board" dest="vendor/espressif/boards/esp32p4/esp32p4-function-ev-board"/>

    <!-- <linkfile src="packages/cAGENT" dest="packages/cAGENT"/> -->
    <!-- <linkfile src="demos/smart_home" dest="packages/demos/smart_home"/> -->
  </project>
</manifest>

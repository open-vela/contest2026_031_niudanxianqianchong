#
# ESP32-P4X MIPI-CSI staged camera probe.
#

config LVX_USE_DEMO_CONTEST2026_031_CSI_PROBE
	bool "ESP32-P4X SC2336 camera probe"
	depends on ARCH_BOARD_ESP32P4_FUNCTION_EV_BOARD
	select ESPRESSIF_I2C0
	select I2C_RESET
	select ESPRESSIF_MIPI_CSI
	select ESPRESSIF_SPIRAM
	select ESPRESSIF_SPIRAM_USER_HEAP
	select ESP32P4_FUNCTION_EV_BOARD_CAMERA
	select ESP32P4_FUNCTION_EV_BOARD_CAMERA_SC2336
	default n
	---help---
		Build csi_probe, the staged camera validation program for the P4X
		Function EV Board.  "csi_probe sensor" validates the SC2336 product
		ID over SCCB/I2C0.  "csi_probe raw [1-10]" configures the P2
		1024x600 RAW8 sensor profile, collects bounded CSI/DMA frames in
		PSRAM, and reports CRC and CSI/DMA error diagnostics.  It does not
		register /dev/video0 or enable ISP processing.
